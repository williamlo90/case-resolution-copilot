{
  "$defs": {
    "ManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "family_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Family Id",
          "type": "string"
        },
        "sop_family_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Sop Family Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "label_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Label Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "family_id",
        "sop_family_id",
        "input_sha256",
        "label_sha256"
      ],
      "title": "ManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "case-resolution-v2-manifest-1",
      "title": "Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "regression",
        "holdout",
        "time_study"
      ],
      "title": "Split",
      "type": "string"
    },
    "state": {
      "enum": [
        "planned",
        "sealed",
        "exposed"
      ],
      "title": "State",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sealed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sealed At"
    },
    "product_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Product Revision"
    },
    "config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Config Sha256"
    },
    "model_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Version"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prompt Version"
    },
    "scorer_version": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scorer Version"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "version",
    "split",
    "state",
    "seed",
    "sealed_at",
    "product_revision",
    "config_sha256",
    "model_version",
    "prompt_version",
    "scorer_version",
    "entries"
  ],
  "title": "SplitManifest",
  "type": "object"
}
