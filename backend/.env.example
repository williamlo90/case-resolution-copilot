# Compatibility prefix retained after the Case Resolution Copilot rename.
SUPPORT_COPILOT_ENVIRONMENT=development
SUPPORT_COPILOT_AUTH_MODE=deterministic_development
SUPPORT_COPILOT_LOG_LEVEL=INFO
SUPPORT_COPILOT_API_HOST=127.0.0.1
SUPPORT_COPILOT_API_PORT=8000
SUPPORT_COPILOT_DATABASE_URL=postgresql+psycopg://support_copilot:support_copilot@127.0.0.1:5432/support_copilot
SUPPORT_COPILOT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SUPPORT_COPILOT_CLERK_SECRET_KEY=replace_with_clerk_secret_key
SUPPORT_COPILOT_CLERK_JWT_KEY="replace_with_clerk_pem_public_key"
SUPPORT_COPILOT_CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
SUPPORT_COPILOT_MODEL_PROVIDER=deterministic
SUPPORT_COPILOT_EMBEDDING_PROVIDER=deterministic
SUPPORT_COPILOT_OPENAI_API_KEY=replace_with_openai_api_key
SUPPORT_COPILOT_OPENAI_MODEL=gpt-5.6-luna
SUPPORT_COPILOT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPPORT_COPILOT_OPENAI_TIMEOUT_SECONDS=12
SUPPORT_COPILOT_OPENAI_MAX_RETRIES=1
SUPPORT_COPILOT_CASE_SOURCE_PROVIDER=disabled
SUPPORT_COPILOT_ACTION_TARGET_PROVIDER=deterministic
SUPPORT_COPILOT_INTEGRATION_ORGANIZATION_ID=ORG-0001
SUPPORT_COPILOT_CASE_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
SUPPORT_COPILOT_CASE_WEBHOOK_MAX_AGE_SECONDS=300
SUPPORT_COPILOT_ACTION_WEBHOOK_URL=https://sandbox.example.com/support-actions
SUPPORT_COPILOT_ACTION_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
SUPPORT_COPILOT_ACTION_WEBHOOK_TIMEOUT_SECONDS=5

# Connected Inbox remains disabled until the database migration and Google OAuth setup pass.
SUPPORT_COPILOT_INBOX_CONNECTIONS_ENABLED=false
SUPPORT_COPILOT_GMAIL_ADAPTER_ENABLED=false
SUPPORT_COPILOT_INBOX_SCHEDULED_SYNC_ENABLED=false
SUPPORT_COPILOT_GMAIL_PUSH_ENABLED=false
SUPPORT_COPILOT_INBOX_DRAFT_WRITEBACK_ENABLED=false
SUPPORT_COPILOT_INBOX_AI_DATA_TRANSFER_ENABLED=false
SUPPORT_COPILOT_GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
SUPPORT_COPILOT_GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
SUPPORT_COPILOT_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/connections/inbox/callback
SUPPORT_COPILOT_CREDENTIAL_VAULT_KEY=replace_with_urlsafe_base64_32_byte_key
SUPPORT_COPILOT_CREDENTIAL_VAULT_KEY_ID=env-v1
SUPPORT_COPILOT_INBOX_SCHEDULER_SECRET=replace_with_at_least_32_random_characters
SUPPORT_COPILOT_GMAIL_PUBSUB_AUDIENCE=replace_only_when_push_is_enabled
SUPPORT_COPILOT_GMAIL_PUBSUB_SERVICE_ACCOUNT=replace_only_when_push_is_enabled
SUPPORT_COPILOT_INBOX_INITIAL_WINDOW_DAYS=14
SUPPORT_COPILOT_INBOX_INITIAL_ITEM_LIMIT=25
SUPPORT_COPILOT_INBOX_SYNC_JOB_LIMIT=10
SUPPORT_COPILOT_INBOX_SYNC_MESSAGE_LIMIT=50
SUPPORT_COPILOT_INBOX_PROVIDER_TIMEOUT_SECONDS=8

# Governed Policy RAG V2 is indexed separately and defaults to the existing V1 read path.
SUPPORT_COPILOT_POLICY_RETRIEVAL_MODE=v1
SUPPORT_COPILOT_POLICY_V2_EMBEDDING_PROVIDER=deterministic
SUPPORT_COPILOT_POLICY_V2_PROFILE_KEY=deterministic-hash-v2-d512
SUPPORT_COPILOT_POLICY_INDEXING_ENABLED=false
SUPPORT_COPILOT_POLICY_INDEX_SCHEDULER_SECRET=replace_with_at_least_32_random_characters
SUPPORT_COPILOT_POLICY_INDEX_JOB_LIMIT=5
SUPPORT_COPILOT_POLICY_EMBEDDING_BATCH_SIZE=16
SUPPORT_COPILOT_POLICY_QUERY_CHAR_LIMIT=2000
