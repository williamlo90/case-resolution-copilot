FROM postgres:16-alpine AS builder

# pgvector v0.8.7; verify the source identity before compilation.
RUN apk add --no-cache build-base git \
    && git clone --branch v0.8.7 --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && test "$(git -C /tmp/pgvector rev-parse HEAD)" = "f37c13f68b57d2c3472b2214fbcff699d6d34876" \
    && cd /tmp/pgvector \
    && make OPTFLAGS="" with_llvm=no \
    && make install with_llvm=no

FROM postgres:16-alpine
RUN apk upgrade --no-cache \
    && apk add --no-cache su-exec \
    && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec \
    && sed -i 's/exec gosu /exec su-exec /g' /usr/local/bin/docker-entrypoint.sh \
    && test ! -e /usr/local/bin/gosu \
    && su-exec nobody true
COPY --from=builder /usr/local/lib/postgresql/vector.so /usr/local/lib/postgresql/vector.so
COPY --from=builder /usr/local/share/postgresql/extension/vector* /usr/local/share/postgresql/extension/
COPY --from=builder /tmp/pgvector/LICENSE /usr/share/doc/pgvector/LICENSE
